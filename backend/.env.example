PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/clothing_store
NODE_ENV=development
# Comma-separated list of allowed browser origins. CLIENT_URL is honoured as a
# fallback when ALLOWED_ORIGINS is not set.
ALLOWED_ORIGINS=
CLIENT_URL=http://localhost:5173

# Generate a strong random secret for production, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Rate limiting (only enforced when NODE_ENV=production). Defaults are shown.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=100
COUPON_RATE_LIMIT_WINDOW_MS=900000
COUPON_RATE_LIMIT_MAX=30
REVIEW_RATE_LIMIT_WINDOW_MS=900000
REVIEW_RATE_LIMIT_MAX=20

# Development admin credentials (used by `npm run create:admin` only)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345

# Media provider: 'cloudinary' (the only supported upload provider).
# When set to anything else (or unset), media upload/delete endpoints return
# 501 MEDIA_PROVIDER_NOT_CONFIGURED.
MEDIA_PROVIDER=cloudinary
# Stock at or below this value is considered low stock
LOW_STOCK_THRESHOLD=5

# Cloudinary credentials (required when MEDIA_PROVIDER=cloudinary).
# Get them from https://console.cloudinary.com -> Dashboard.
# NEVER commit real credentials; keep them only in .env (git-ignored).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Uploads are stored under an allowlisted folder such as deer/products.
# NOTE: browser clients must upload images via multipart/form-data (field
# "file"). The API no longer accepts server filesystem paths (filePath).

# Razorpay (TEST/SANDBOX credentials only, never production)
# Payment endpoints return 503 when RAZORPAY_ENABLED or keys are missing.
# Get test keys from https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_ENABLED=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email & notifications
# EMAIL_ENABLED=true enables real sending; otherwise emails are logged in dev mode.
EMAIL_ENABLED=
# Email provider: 'log' (default) or 'smtp'
EMAIL_PROVIDER=log
# From address used on outgoing email
EMAIL_FROM=Deer Clothing <no-reply@deer.local>
# SMTP (only needed when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Admin alert recipient for payment failures / refunds (optional)
ADMIN_NOTIFICATION_EMAIL=
# Max send attempts for a single email before it is abandoned
EMAIL_MAX_RETRIES=3